# Firebase is the application's database, authentication, and file storage.
# Copy this file to .env.local and replace the placeholder values.
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=

# Optional AI integrations
VITE_OPENAI_API_KEY=
VITE_GEMINI_API_KEY=

# Optional media upload integrations
VITE_UPI_ID=your_upi_id@bank
VITE_UPI_NAME=Your Name
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset
VITE_REMOVEBG_API_KEY=

# Supabase (migration target)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-side only; never expose as VITE_ or commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# Seed credentials are local-only and must be replaced before use.
SEED_ADMIN_PASSWORD=
SEED_FACULTY_PASSWORD=
SEED_STUDENT_PASSWORD=
SEED_PLACEMENT_PASSWORD=
SEED_RECRUITER_PASSWORD=
